{
  "name": "cygnat-cc-framework",
  "version": "0.1.0",
  "description": "A Cocos Creator TypeScript game framework.",
  "private": true,
  "type": "module",
  "main": "./dist/header.js",
  "types": "./dist/header.d.ts",
  "exports": {
    ".": {
      "types": "./dist/header.d.ts",
      "import": "./dist/header.js"
    },
    "./Core": {
      "types": "./dist/Core/index.d.ts",
      "import": "./dist/Core/index.js"
    },
    "./Asset": {
      "types": "./dist/Asset/index.d.ts",
      "import": "./dist/Asset/index.js"
    },
    "./Event": {
      "types": "./dist/Event/index.d.ts",
      "import": "./dist/Event/index.js"
    },
    "./UI": {
      "types": "./dist/UI/index.d.ts",
      "import": "./dist/UI/index.js"
    },
    "./MiniGame": {
      "types": "./dist/MiniGame/index.d.ts",
      "import": "./dist/MiniGame/index.js"
    },
    "./Net": {
      "types": "./dist/Net/index.d.ts",
      "import": "./dist/Net/index.js"
    },
    "./ECS": {
      "types": "./dist/ECS/index.d.ts",
      "import": "./dist/ECS/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-package-types.mjs",
    "prepare": "npm run build",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyc19961996/CygnatCCFramework.git"
  },
  "keywords": [
    "cocos-creator",
    "cocos",
    "typescript",
    "game-framework"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
