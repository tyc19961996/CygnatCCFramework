{
  "name": "cygnat-cc-framework",
  "version": "0.3.0",
  "description": "A Cocos Creator TypeScript game framework.",
  "private": true,
  "type": "module",
  "main": "./dist/header.js",
  "types": "./dist/header.d.ts",
  "exports": {
    ".": {
      "types": "./dist/header.d.ts",
      "import": "./dist/header.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-package-types.mjs && node scripts/fix-esm-extensions.mjs",
    "prepare": "npm run build",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyc19961996/CygnatCCFramework.git"
  },
  "keywords": [
    "cocos-creator",
    "cocos",
    "typescript",
    "game-framework"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
